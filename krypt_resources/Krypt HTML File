<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#090411"><title>KRYPT — Your world. Under your control.</title>
<style>
:root{--bg:#090411;--panel:#130b20;--panel2:#1b112b;--line:#342345;--text:#faf7ff;--muted:#b2a2c4;--purple:#922cff;--lav:#ddaaff;--good:#62d9a8;--bad:#ff8299}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px Inter,system-ui,sans-serif;min-height:100vh}button,input,textarea,select{font:inherit}button{cursor:pointer}.ambient{position:fixed;inset:0;z-index:-1;background:radial-gradient(ellipse at 5% 0%,#7012c94d,transparent 35%),radial-gradient(ellipse at 95% 100%,#6c0cba45,transparent 38%),#090411}
#splash{position:fixed;inset:0;background:radial-gradient(ellipse at 50% 42%,#39066a,#10031e 48%,#07020d);display:grid;place-items:center;z-index:30;transition:.8s}#splash.hide{opacity:0;visibility:hidden}.splash{text-align:center;animation:up 1s both}.splash img{width:min(280px,60vw);filter:drop-shadow(0 0 35px #a93cff);animation:float 3s ease-in-out infinite}.splash b{display:block;letter-spacing:.5em;padding-left:.5em;font-size:24px;margin-top:10px}.splash small{display:block;color:#c6a2e5;letter-spacing:.2em;margin-top:14px}.bar{width:180px;height:2px;background:#ffffff22;margin:25px auto;overflow:hidden}.bar i{display:block;height:100%;background:#ce8bff;animation:load 2.1s ease forwards}@keyframes load{to{width:100%}}@keyframes float{50%{transform:translateY(-9px)}}@keyframes up{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
button{border:0}.primary{background:linear-gradient(110deg,#7518df,#b34bff);color:white;border-radius:10px;padding:11px 16px;font-weight:650;box-shadow:0 8px 24px #7d1bdb44}.secondary,.iconbtn{background:var(--panel2);border:1px solid var(--line);color:var(--text);border-radius:10px;padding:10px 13px}.primary:hover,.secondary:hover,.iconbtn:hover{filter:brightness(1.14)}
.landing{min-height:100vh}.landing header{height:76px;max-width:1240px;margin:auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff12}.brand{display:flex;align-items:center;gap:10px;font-weight:850;letter-spacing:.27em;font-size:18px}.brand img{width:34px;height:34px;object-fit:contain}.landing nav{display:flex;gap:26px}.landing nav a{color:#c6b6d4;text-decoration:none}.hero{max-width:1200px;margin:auto;min-height:630px;padding:70px 30px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:40px}.eyebrow{display:inline-block;border:1px solid #a34bff66;border-radius:99px;padding:8px 13px;color:#d8b3ff;letter-spacing:.16em;font-size:10px}.hero h1{font-size:clamp(48px,6vw,78px);line-height:.98;letter-spacing:-.06em;margin:24px 0}.grad{background:linear-gradient(100deg,#fff,#dca6ff 50%,#963cff);color:transparent;background-clip:text}.hero p{max-width:500px;color:#b8a8c8;line-height:1.8;font-size:16px}.hero-art{position:relative;display:grid;place-items:center;min-height:420px}.hero-art:before{content:"";position:absolute;width:75%;aspect-ratio:1;border:1px solid #c184ff44;border-radius:50%;box-shadow:0 0 100px #8e25d933,inset 0 0 70px #8e25d922;animation:float 5s infinite}.hero-art img{width:90%;max-width:460px;filter:drop-shadow(0 0 40px #a63dff99);z-index:1}.landing .features{max-width:1200px;margin:auto;padding:65px 30px 100px}.features h2{text-align:center;font-size:38px}.featuregrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:30px}.feature{background:linear-gradient(145deg,#1b0d2c,#100919);border:1px solid #ffffff18;padding:25px;border-radius:18px}.feature .symbol{font-size:26px;color:#d5a0ff}.feature p{color:#b2a2c4;line-height:1.65}
#workspace{display:none;min-height:100vh}.layout{display:flex;min-height:100vh}.sidebar{width:238px;flex-shrink:0;background:#100a19;border-right:1px solid #ffffff14;padding:23px 14px;display:flex;flex-direction:column}.sidebrand{font-weight:850;letter-spacing:.25em;padding:6px 12px 28px}.navlabel{font-size:10px;letter-spacing:.2em;color:#907e9f;padding:12px}.navbtn{width:100%;text-align:left;background:transparent;color:#b8a9c7;padding:12px;border-radius:10px;margin:3px 0}.navbtn.active,.navbtn:hover{background:#8c27e82b;color:white}.sidebottom{margin-top:auto}.content{flex:1;min-width:0;padding:25px 32px;max-width:1500px;margin:auto;width:100%}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:30px}.search{width:min(260px,35vw);background:var(--panel);border:1px solid var(--line);padding:11px 13px;border-radius:10px;color:white}.topright{display:flex;gap:8px}.page{display:none}.page.active{display:block}h1{font-size:29px;margin:0 0 8px}h2{font-size:17px;margin:0 0 15px}.sub{color:var(--muted);margin:0 0 24px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin:20px 0}.card{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:18px;min-width:0}.metriclabel{color:var(--muted);font-size:12px}.metric{font-size:25px;font-weight:750;margin:11px 0}.muted{color:var(--muted)}.cols{display:grid;grid-template-columns:1.4fr 1fr;gap:14px}.empty{padding:25px;text-align:center;border:1px dashed var(--line);border-radius:12px;color:var(--muted)}.row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}.row:last-child{border:0}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:15px 0}.field{width:100%;padding:11px 12px;border-radius:9px;background:var(--panel2);border:1px solid var(--line);color:white;outline:none}.field:focus,.search:focus{border-color:#a35aff}label{display:block;color:var(--muted);font-size:12px;margin:12px 0 6px}.notice{padding:13px;border:1px solid #a14bff55;background:#8524d315;border-radius:11px;color:#c6b6d4;line-height:1.55}.table{width:100%;border-collapse:collapse}.table td,.table th{text-align:left;padding:12px 8px;border-bottom:1px solid var(--line)}.table th{color:var(--muted);font-weight:500}.chatlog{height:340px;overflow:auto;background:#0d0715;border:1px solid var(--line);border-radius:12px;padding:15px}.bubble{padding:11px 13px;border-radius:12px;margin:8px 0;max-width:85%;line-height:1.55}.bubble.user{background:#6e20b955;margin-left:auto}.bubble.ai{background:#241333}.fab{position:fixed;right:24px;bottom:22px;border-radius:99px;padding:13px 18px;background:linear-gradient(110deg,#7618e2,#bd62ff);color:white;box-shadow:0 8px 28px #8a27e866}.status{font-size:11px;color:var(--good)}.modal{position:fixed;inset:0;background:#000a;display:none;place-items:center;padding:20px;z-index:15}.modal.show{display:grid}.modalbox{background:#170d23;border:1px solid var(--line);padding:23px;border-radius:16px;width:min(470px,100%)}
.toast{position:fixed;right:20px;bottom:82px;background:#241333;border:1px solid var(--line);border-radius:10px;padding:12px 16px;display:none;z-index:20}
body.light{--bg:#f6f2fb;--panel:#fff;--panel2:#f0eaf7;--line:#e3d9ee;--text:#21152d;--muted:#70617d;background:var(--bg);color:var(--text)}body.light .sidebar{background:#fff}body.light .search,body.light .field{color:#21152d}body.light .feature{background:white}
@media(max-width:900px){.sidebar{width:190px}.cards{grid-template-columns:repeat(2,1fr)}.cols{grid-template-columns:1fr}.hero{grid-template-columns:1fr}.hero-art{min-height:300px}.featuregrid{grid-template-columns:1fr}}
@media(max-width:620px){.sidebar{width:64px;padding:15px 6px}.sidebrand{font-size:0;padding:8px}.navbtn{font-size:0;text-align:center;padding:13px 2px}.navbtn:first-letter{font-size:17px}.navlabel{display:none}.content{padding:18px 12px}.top{align-items:flex-start;flex-direction:column}.topright{width:100%;flex-wrap:wrap}.search{width:100%}.cards{gap:8px}.metric{font-size:20px}.landing nav{display:none}.hero{padding:55px 22px}.hero h1{font-size:53px}.landing .features{padding:50px 22px}.featuregrid{grid-template-columns:1fr}}
</style></head><body><div class="ambient"></div>
<div id="splash"><div class="splash"><img src="data:image/png;base64," alt="Krypt"><b>KRYPT</b><small>YOUR WORLD. UNDER YOUR CONTROL.</small><div class="bar"><i></i></div></div></div>
<section class="landing" id="landing"><header><div class="brand"><img src="data:image/png;base64," alt=""> KRYPT</div><nav><a href="#vaultFeature">Private Vault</a><a href="#financeFeature">Financial Hub</a><a href="#aiFeature">Krypt AI</a></nav><div><button class="secondary" onclick="toggleTheme()">◐</button> <button class="primary" onclick="enterApp()">Enter Krypt ↗</button></div></header>
<div class="hero"><div><span class="eyebrow">✦ YOUR DIGITAL WORLD, REIMAGINED</span><h1>Everything<br>valuable.<br><span class="grad">One place.</span></h1><p>Protect what matters. Understand what moves you. Bring your private files, financial world and intelligent tools together in one considered space.</p><button class="primary" onclick="enterApp()">Enter Krypt ↗</button> <a class="secondary" href="#discover" style="text-decoration:none">Discover ↓</a></div><div class="hero-art"><img src="data:image/png;base64," alt="Krypt emblem"></div></div>
<div class="features" id="discover"><div style="text-align:center;color:#c58aff;letter-spacing:.2em;font-size:11px">ONE PLATFORM. THREE DIMENSIONS.</div><h2>More control. <span class="grad">Less complexity.</span></h2><div class="featuregrid"><article class="feature" id="vaultFeature"><div class="symbol">◈</div><h3>Private Vault</h3><p>Multiple vaults for your important files, protected with server-side encryption in this local prototype.</p></article><article class="feature" id="financeFeature"><div class="symbol">⌁</div><h3>Financial Hub</h3><p>Stocks and digital assets in one view, with optional market data provider connections.</p></article><article class="feature" id="aiFeature"><div class="symbol">✧</div><h3>Krypt AI</h3><p>Your AI assistant for explanations, summaries and navigating your workspace.</p></article></div></div></section>

<section id="workspace"><div class="layout"><aside class="sidebar"><div class="sidebrand">✦ KRYPT</div><div class="navlabel">WORKSPACE</div>
<button class="navbtn active" data-page="overview" onclick="go('overview',this)">▦ &nbsp; Overview</button><button class="navbtn" data-page="vault" onclick="go('vault',this)">◈ &nbsp; Private Vault</button><button class="navbtn" data-page="markets" onclick="go('markets',this)">⌁ &nbsp; Markets</button><button class="navbtn" data-page="portfolio" onclick="go('portfolio',this)">◫ &nbsp; Portfolio</button><button class="navbtn" data-page="transactions" onclick="go('transactions',this)">⇄ &nbsp; Transactions</button><button class="navbtn" data-page="assistant" onclick="go('assistant',this)">✧ &nbsp; Krypt AI</button><button class="navbtn" data-page="recent" onclick="go('recent',this)">◷ &nbsp; Recently opened</button><button class="navbtn" data-page="settings" onclick="go('settings',this)">⚙ &nbsp; Settings</button><div class="sidebottom"><button class="navbtn" onclick="quickLock()">⌑ &nbsp; Quick Lock</button><button class="navbtn" onclick="backLanding()">↩ &nbsp; Landing page</button></div></aside>
<main class="content"><div class="top"><div><div class="muted">KRYPT / <b id="crumb">OVERVIEW</b></div></div><div class="topright"><input id="search" class="search" placeholder="⌕ Search Krypt..." onkeydown="if(event.key==='Enter')searchAll()"><button class="iconbtn" onclick="notify()">♧</button><button class="iconbtn" onclick="toggleTheme()">◐</button><button class="iconbtn" onclick="go('settings')">K</button></div></div>
<section class="page active" id="page-overview"><h1>Welcome back.</h1><p class="sub">Your digital world, at a glance.</p><div class="cards"><div class="card"><div class="metriclabel">Vaults</div><div class="metric" id="vaultCount">0</div><div class="muted">Your private spaces</div></div><div class="card"><div class="metriclabel">Protected files</div><div class="metric" id="fileCount">0</div><div class="muted">Encrypted on this server</div></div><div class="card"><div class="metriclabel">Watchlist</div><div class="metric">0</div><div class="muted">Connect a market provider</div></div><div class="card"><div class="metriclabel">AI status</div><div class="metric" style="font-size:18px" id="aiStatus">Checking…</div><div class="muted">NVIDIA connection</div></div></div><div class="cols"><div class="card"><h2>Workspace activity</h2><div id="activity" class="empty">Your recent activity will appear here.</div></div><div class="card"><h2>Quick actions</h2><div class="toolbar"><button class="primary" onclick="newVault()">＋ New vault</button><button class="secondary" onclick="go('assistant')">Ask Krypt AI</button><button class="secondary" onclick="go('markets')">Explore markets</button></div><p class="muted">Tip: press Ctrl/⌘ + K to search.</p></div></div></section>
<section class="page" id="page-vault"><h1>Private Vault</h1><p class="sub">Create vaults and upload files. Files are encrypted by the Python backend before storage.</p><div class="notice">Local prototype security: file contents are encrypted using a server-held Fernet key. Back up that key securely; losing it makes encrypted files unrecoverable. This is not yet audited production vault security.</div><div class="toolbar"><button class="primary" onclick="newVault()">＋ Create vault</button><select id="vaultSelect" class="field" style="max-width:240px" onchange="loadFiles()"><option value="">Select a vault</option></select><input id="uploadFile" type="file" style="max-width:240px;color:var(--muted)"><button class="secondary" onclick="uploadFile()">Upload & encrypt</button></div><div id="vaultList" class="card"><div class="empty">Loading vaults…</div></div><div class="card" style="margin-top:14px"><h2>Files</h2><div id="fileList" class="empty">Select a vault to view its files.</div></div></section>
<section class="page" id="page-markets"><h1>Markets</h1><p class="sub">Market data depends on the provider keys configured on your backend.</p><div class="toolbar"><button class="secondary" onclick="loadMarkets()">↻ Refresh markets</button></div><div class="cols"><div class="card"><h2>Stocks</h2><div id="stocks" class="empty">Connect Finnhub in .env to load stock quotes.</div></div><div class="card"><h2>Crypto</h2><div id="crypto" class="empty">Connect CoinGecko in .env to load crypto prices.</div></div></div></section>
<section class="page" id="page-portfolio"><h1>Portfolio</h1><p class="sub">A starter portfolio workspace. No real trades are placed by this prototype.</p><div class="card"><div class="empty">Portfolio holdings and allocation will appear here when portfolio records are added.</div></div></section>
<section class="page" id="page-transactions"><h1>Transactions</h1><p class="sub">Activity ledger for the prototype.</p><div class="card"><div class="empty">No transactions yet. Trading is not enabled.</div></div></section>
<section class="page" id="page-assistant"><h1>Krypt AI</h1><p class="sub">Ask questions, get explanations and work with your Krypt workspace.</p><div class="card"><div class="chatlog" id="chatlog"><div class="bubble ai">Hello. I'm Krypt AI. Configure your NVIDIA API key in the backend .env file to enable responses.</div></div><div class="toolbar"><textarea class="field" id="chatInput" rows="2" placeholder="Ask Krypt AI anything…" style="flex:1;resize:vertical"></textarea><button class="primary" onclick="sendChat()">Send ↗</button></div><div class="muted">Do not send passwords, seed phrases, private keys or sensitive financial credentials to an AI model.</div></div></section>
<section class="page" id="page-recent"><h1>Recently opened</h1><p class="sub">Your latest vault and file activity.</p><div class="card" id="recentList"><div class="empty">No recent activity yet.</div></div></section>
<section class="page" id="page-settings"><h1>Settings</h1><p class="sub">Application and service status.</p><div class="card"><h2>Backend health</h2><div id="health" class="muted">Checking…</div></div><div class="card" style="margin-top:14px"><h2>AI configuration</h2><p class="muted">Set NVIDIA_NIM_API_KEY in the .env file on the backend machine. Never put it in this page or browser storage.</p><div id="configAI" class="notice">Checking AI configuration…</div><p class="muted">Model: <code>nvidia/nemotron-3.5-lightning-30b-a3b</code></p></div><div class="card" style="margin-top:14px"><h2>Market data providers</h2><p class="muted">Optional server-side keys: FINNHUB_API_KEY and COINGECKO_API_KEY. The app remains usable without them.</p><div id="configMarket" class="notice">Checking provider configuration…</div></div><div class="card" style="margin-top:14px"><h2>Appearance</h2><button class="secondary" onclick="toggleTheme()">Toggle dark / light</button></div></section>
</main></div></section>
<button class="fab" id="fab" onclick="go('assistant')">✧ Krypt AI</button><div class="toast" id="toast"></div>
<div class="modal" id="vaultModal"><div class="modalbox"><h2>Create a vault</h2><label>Vault name</label><input id="newVaultName" class="field" placeholder="Personal documents"><div class="toolbar" style="justify-content:flex-end"><button class="secondary" onclick="closeVaultModal()">Cancel</button><button class="primary" onclick="createVault()">Create vault</button></div></div></div>
<script>
const API='';let vaults=[];
function toast(s){let t=document.getElementById('toast');t.textContent=s;t.style.display='block';setTimeout(()=>t.style.display='none',3200)}
async function api(path,opts={}){let r=await fetch(API+path,opts);let data;try{data=await r.json()}catch{data={detail:'Unexpected server response'}}if(!r.ok)throw Error(data.detail||'Request failed');return data}
window.addEventListener('load',()=>setTimeout(()=>document.getElementById('splash').classList.add('hide'),2200));
function enterApp(){document.getElementById('landing').style.display='none';document.getElementById('workspace').style.display='block';document.getElementById('fab').style.display='block';refresh();loadMarkets()}
function backLanding(){document.getElementById('workspace').style.display='none';document.getElementById('landing').style.display='block';document.getElementById('fab').style.display='none'}
function go(name,btn){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById('page-'+name).classList.add('active');document.querySelectorAll('.navbtn[data-page]').forEach(x=>x.classList.remove('active'));let b=btn||document.querySelector('[data-page="'+name+'"]');if(b)b.classList.add('active');document.getElementById('crumb').textContent=name.toUpperCase();if(name==='vault')loadVaults();if(name==='markets')loadMarkets();if(name==='settings')loadStatus();if(name==='recent')loadRecent()}
function toggleTheme(){document.body.classList.toggle('light');localStorage.setItem('krypt-theme',document.body.classList.contains('light')?'light':'dark')}
if(localStorage.getItem('krypt-theme')==='light')document.body.classList.add('light');
function notify(){toast('You are all caught up.')}
function quickLock(){document.querySelectorAll('input[type=file]').forEach(x=>x.value='');document.getElementById('chatInput').value='';go('vault');toast('Local quick lock: cleared visible file/chat inputs. This is not a substitute for session authentication or device locking.')}
function newVault(){document.getElementById('vaultModal').classList.add('show')}function closeVaultModal(){document.getElementById('vaultModal').classList.remove('show')}
async function createVault(){let name=document.getElementById('newVaultName').value.trim();if(!name)return toast('Enter a vault name.');try{await api('/api/vaults',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})});closeVaultModal();document.getElementById('newVaultName').value='';toast('Vault created.');loadVaults();refresh()}catch(e){toast(e.message)}}
async function loadVaults(){try{let d=await api('/api/vaults');vaults=d.vaults;let list=document.getElementById('vaultList');list.innerHTML=vaults.length?'':'<div class="empty">No vaults yet. Create your first vault.</div>';let sel=document.getElementById('vaultSelect');sel.innerHTML='<option value="">Select a vault</option>';vaults.forEach(v=>{let row=document.createElement('div');row.className='row';row.innerHTML='<b></b><span class="muted">Created '+new Date(v.created_at).toLocaleString()+'</span>';row.querySelector('b').textContent=v.name;list.appendChild(row);let o=document.createElement('option');o.value=v.id;o.textContent=v.name;sel.appendChild(o)});document.getElementById('vaultCount').textContent=vaults.length}catch(e){toast(e.message)}}
async function loadFiles(){let id=document.getElementById('vaultSelect').value;let box=document.getElementById('fileList');if(!id){box.textContent='Select a vault to view its files.';return}try{let d=await api('/api/vaults/'+id+'/files');box.innerHTML=d.files.length?'':'<div class="empty">No files in this vault.</div>';d.files.forEach(f=>{let row=document.createElement('div');row.className='row';let left=document.createElement('span');left.textContent=f.filename+' · '+Math.round(f.size/1024)+' KB';let btn=document.createElement('button');btn.className='secondary';btn.textContent='Download decrypted';btn.onclick=()=>downloadFile(id,f.id,f.filename);row.append(left,btn);box.append(row)})}catch(e){toast(e.message)}}
async function uploadFile(){let id=document.getElementById('vaultSelect').value,f=document.getElementById('uploadFile').files[0];if(!id)return toast('Select a vault first.');if(!f)return toast('Choose a file first.');let form=new FormData();form.append('file',f);try{await api('/api/vaults/'+id+'/files',{method:'POST',body:form});toast('File encrypted and uploaded.');document.getElementById('uploadFile').value='';loadFiles();refresh()}catch(e){toast(e.message)}}
async function downloadFile(vault,id,name){try{let r=await fetch('/api/vaults/'+vault+'/files/'+id+'/download');if(!r.ok)throw Error('Download failed');let blob=await r.blob(),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();URL.revokeObjectURL(a.href)}catch(e){toast(e.message)}}
async function sendChat(){let input=document.getElementById('chatInput'),q=input.value.trim();if(!q)return;let log=document.getElementById('chatlog');let u=document.createElement('div');u.className='bubble user';u.textContent=q;log.append(u);input.value='';let wait=document.createElement('div');wait.className='bubble ai';wait.textContent='Krypt is thinking…';log.append(wait);log.scrollTop=log.scrollHeight;try{let d=await api('/api/ai/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:q})});wait.textContent=d.reply}catch(e){wait.textContent='AI unavailable: '+e.message}log.scrollTop=log.scrollHeight}
async function loadMarkets(){try{let d=await api('/api/markets');document.getElementById('stocks').innerHTML=d.stocks.length?d.stocks.map(x=>'<div class="row"><b>'+x.symbol+'</b><span>'+x.price+'</span></div>').join(''):'<div class="empty">'+(d.stock_message||'No stock quotes returned.')+'</div>';document.getElementById('crypto').innerHTML=d.crypto.length?d.crypto.map(x=>'<div class="row"><b>'+x.name+'</b><span>$'+Number(x.usd).toLocaleString()+'</span></div>').join(''):'<div class="empty">'+(d.crypto_message||'No crypto quotes returned.')+'</div>'}catch(e){toast(e.message)}}
async function loadStatus(){try{let d=await api('/api/health');document.getElementById('health').textContent='Backend online · '+d.database;document.getElementById('configAI').textContent=d.ai_configured?'NVIDIA key detected. Model: '+d.ai_model:'NVIDIA key not configured. Add it to .env and restart.';document.getElementById('configMarket').textContent='Finnhub: '+(d.finnhub_configured?'configured':'not configured')+' · CoinGecko: '+(d.coingecko_configured?'configured':'not configured');document.getElementById('aiStatus').textContent=d.ai_configured?'Connected':'Not configured'}catch(e){document.getElementById('health').textContent='Backend unavailable: '+e.message}}
async function refresh(){await loadVaults();await loadStatus();try{let d=await api('/api/activity');document.getElementById('activity').innerHTML=d.items.length?d.items.map(x=>'<div class="row"><span>'+x.action+'</span><span class="muted">'+new Date(x.created_at).toLocaleString()+'</span></div>').join(''):'<div class="empty">No activity yet.</div>';document.getElementById('fileCount').textContent=d.file_count}catch{}}
async function loadRecent(){try{let d=await api('/api/activity');document.getElementById('recentList').innerHTML=d.items.length?d.items.map(x=>'<div class="row">'+x.action+'<span class="muted">'+new Date(x.created_at).toLocaleString()+'</span></div>').join(''):'<div class="empty">No recent activity yet.</div>'}catch{}}
function searchAll(){let q=document.getElementById('search').value.toLowerCase();let map={vault:'vault',file:'vault',stock:'markets',crypto:'markets',market:'markets',ai:'assistant',assistant:'assistant',portfolio:'portfolio',transaction:'transactions',setting:'settings',recent:'recent'};let key=Object.keys(map).find(k=>q.includes(k));if(key)go(map[key]);else toast('No matching section found.')}
document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();if(document.getElementById('workspace').style.display==='block')document.getElementById('search').focus();else enterApp()}if(e.key==='Escape')closeVaultModal()});
async function boot(){try{await loadStatus()}catch{}}
boot();
</script></body></html>
